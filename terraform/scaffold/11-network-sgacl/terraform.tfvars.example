# 09-network-sgacl/terraform.tfvars.example
# Reference only: the terraform.tfvars.json beside this file carries the real
# values. AK/SK come from secrets.auto.tfvars.json (gitignored) — never
# commit real keys.

home_region       = "ap-southeast-3"

foundation_state_bucket = "REPLACE_ME-lz-tfstate"

# account -> groups + rules. remote: CIDR | sg:<name> (same account) | self.
# ports: "443", "5985-5986", "80,443", blank = all. Groups have NO implicit
# allows (default rules deleted) — grant egress explicitly.
secgroups = {
  # "workload-account" = {
  #   groups = [
  #     { name = "app-sg-01", description = "App tier", tags = { project = "app" } },
  #     { name = "db-sg-01",  description = "DB tier",  tags = { project = "app" } },
  #   ]
  #   rules = [
  #     { sg = "app-sg-01", direction = "ingress", protocol = "tcp", ports = "443",  remote = "10.0.0.0/8",  description = "Users to app" },
  #     { sg = "db-sg-01",  direction = "ingress", protocol = "tcp", ports = "1433", remote = "sg:app-sg-01", description = "App to MSSQL" },
  #     { sg = "app-sg-01", direction = "egress", remote = "0.0.0.0/0", description = "Egress all (CFW governs destinations)" },
  #     { sg = "db-sg-01",  direction = "egress", remote = "0.0.0.0/0", description = "Egress all (CFW governs destinations)" },
  #   ]
