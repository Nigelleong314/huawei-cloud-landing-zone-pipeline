# 08-network-cfw/terraform.tfvars.example
#
# Normally GENERATED by lz_spec/build_envs.py from sheet 08_CFW. Illustrative only.
# AK/SK come from secrets.auto.tfvars.json (gitignored) — never commit real keys.

home_region       = "ap-southeast-3"
master_access_key = "REPLACE_ME_DO_NOT_COMMIT"
master_secret_key = "REPLACE_ME_DO_NOT_COMMIT"

foundation_state_bucket = "REPLACE_ME-lz-tfstate"
network_state_bucket    = "REPLACE_ME-lz-tfstate"

cfw_account = "lz-infra"

# IP address groups (Border: internet | vpc). Members are IPs/CIDRs/ranges.
address_groups = [
  # { name = "corp-cidrs", border = "internet", address_type = "ipv4", members = ["10.0.0.0/8", "192.168.0.0/16"], description = "Corp networks" },
]

# Domain name groups (type: application | network).
domain_groups = [
  # { name = "app-domains", border = "internet", type = "application", domains = ["*.example.com"], description = "" },
]

# Service groups. Members are 'protocol/srcport/dstport' (protocol tcp|udp|icmp|icmpv6).
service_groups = [
  # { name = "web-svc", border = "internet", members = ["tcp/any/80", "tcp/any/443"], description = "" },
]

# ACL rules. Kind: eip|nat (internet border) or vpc (VPC border). Source/Destination
# tokens: IP/CIDR, addrgroup:<Name>, domaingroup:<Name> (dest only), any. Service
# tokens: any, app:<APP>, svcgroup:<Name>, or inline protocol/srcport/dstport.
acl_rules = [
  # { name = "allow-web-egress", kind = "eip", action = "allow", source = ["addrgroup:corp-cidrs"], destination = ["any"], service = ["svcgroup:web-svc"], status = "enable", description = "" },
  # { name = "deny-vpc-lateral", kind = "vpc", action = "deny",  source = ["any"], destination = ["any"], service = ["any"], status = "enable", description = "" },
]

# Black / white lists. list_type blacklist|whitelist; direction source|destination.
black_white_lists = [
  # { name = "block-bad-ip", border = "internet", list_type = "blacklist", direction = "source", protocol = "any", address_type = "ipv4", address = "203.0.113.0/24", port = "", description = "" },
]
