{
  "home_region": "ap-southeast-1",
  "default_tags": {
    "org": "example"
  },
  "foundation_state_bucket": "example-lz-obs-tfstate-01",
  "hub_account": "EXAMPLE-SharedInfra",
  "spoke_private_supernet": "10.42.0.0/16",
  "enterprise_project_name": "example-shared",
  "inbound_route_table": "er-inbound",
  "outbound_route_table": "er-outbound",
  "enable_vpc_flow_logs": true,
  "flow_log_retention_days": 30,
  "er_name": "example-er-01",
  "er_asn": 64513,
  "er_flow_log_name": "example-er-flowlog",
  "er_auto_accept_shared_attachments": true,
  "er_share_name": "example-er-share",
  "east_west_firewall_mode": "er",
  "er_availability_zones": [
    "ap-southeast-1a",
    "ap-southeast-1b"
  ],
  "hub_vpcs": {
    "example-hub-core-vpc": {
      "cidr": "10.42.0.0/22",
      "subnets": [
        {
          "name": "example-core-sub-a",
          "cidr": "10.42.0.0/24"
        },
        {
          "name": "example-core-sub-b",
          "cidr": "10.42.1.0/24"
        },
        {
          "name": "example-core-att",
          "cidr": "10.42.3.240/28"
        }
      ]
    },
    "example-hub-edge-vpc": {
      "cidr": "10.42.4.0/22",
      "subnets": [
        {
          "name": "example-edge-sub-a",
          "cidr": "10.42.4.0/24"
        },
        {
          "name": "example-edge-att",
          "cidr": "10.42.7.240/28"
        }
      ]
    }
  },
  "er_attachments": [
    {
      "name": "example-hub-core-att",
      "vpc": "example-hub-core-vpc",
      "subnet": "example-core-att",
      "auto_add_route": false,
      "description": "Core hub attachment"
    },
    {
      "name": "example-hub-edge-att",
      "vpc": "example-hub-edge-vpc",
      "subnet": "example-edge-att",
      "auto_add_route": false,
      "description": "Edge hub attachment"
    }
  ],
  "er_route_tables": [
    {
      "name": "er-inbound",
      "description": "All VPC attachments auto-associate; auto static route 0.0.0.0/0 -> CFW"
    },
    {
      "name": "er-outbound",
      "description": "CFW auto-associates; VPC CIDRs auto-propagated; auto 0.0.0.0/0 -> SNAT VPC attachment"
    },
    {
      "name": "er-hybrid",
      "description": "VPN/DC attachments associate here (10_VPN.ERAssocRouteTable); 0/0 -> CFW keeps DC traffic inspected"
    }
  ],
  "cfw_default_route_tables": [
    "er-hybrid"
  ],
  "spokes": {
    "example-prod-a-vpc": {
      "account": "EXAMPLE-Prod-A",
      "vpc_name": "example-prod-a-vpc",
      "vpc_cidr": "10.42.8.0/22",
      "er_attach": true,
      "er_attachment_name": "example-prod-a-vpc-er-attach",
      "er_attach_subnet": "example-prod-a-vpc-att",
      "auto_add_route": false,
      "vpc_tags": {
        "env": "prd",
        "owner": "example-prod"
      },
      "subnets": [
        {
          "name": "example-prod-a-vpc-web",
          "cidr": "10.42.8.0/24",
          "tags": {
            "tier": "web"
          }
        },
        {
          "name": "example-prod-a-vpc-att",
          "cidr": "10.42.11.240/28",
          "tags": {
            "tier": "att"
          }
        }
      ]
    },
    "example-sbx-vpc": {
      "account": "EXAMPLE-Sandbox1",
      "vpc_name": "example-sbx-vpc",
      "vpc_cidr": "10.42.12.0/22",
      "er_attach": false,
      "er_attachment_name": "",
      "er_attach_subnet": "",
      "auto_add_route": false,
      "vpc_tags": {
        "env": "sbx",
        "owner": "example-sbx"
      },
      "subnets": [
        {
          "name": "example-sbx-vpc-main",
          "cidr": "10.42.12.0/24",
          "tags": {
            "tier": "main"
          }
        }
      ]
    }
  }
}