# 07-network-dns/terraform.tfvars.example
#
# Normally GENERATED by lz_spec/build_envs.py from sheet 07_DNS. This example is
# illustrative only. AK/SK come from secrets.auto.tfvars.json (gitignored) — never
# commit real keys.

home_region       = "ap-southeast-3"
master_access_key = "REPLACE_ME_DO_NOT_COMMIT"
master_secret_key = "REPLACE_ME_DO_NOT_COMMIT"

foundation_state_bucket = "REPLACE_ME-lz-tfstate"
network_state_bucket    = "REPLACE_ME-lz-tfstate"

dns_account             = "lz-infra"
enterprise_project_name = ""

# Public zones (internet-resolvable). name ends with a trailing dot.
public_zones = [
  # { name = "example.com.", email = "hostmaster@example.com", ttl = 300, description = "Public apex" },
]

# Private zones. vpcs[] are 05-network VPC NAMES; the first is the primary router,
# the rest are associated. Records live in recordsets.
private_zones = [
  # { name = "internal.example.", vpcs = ["vpc-shared"], ttl = 300, description = "Internal zone" },
]

recordsets = [
  # { zone = "internal.example.", name = "app.internal.example.", type = "A", records = ["10.0.32.10"], ttl = 300, description = "" },
]

# Resolver endpoints. vpc must be a HUB VPC (05-network does not export spoke
# subnet IDs); subnets are subnet NAMES within that VPC (≥2 in different AZs for HA).
resolver_endpoints = [
  # { name = "lz-dns-inbound",  direction = "inbound",  vpc = "vpc-shared", subnets = ["shared-dns"], ips = [] },
  # { name = "lz-dns-outbound", direction = "outbound", vpc = "vpc-shared", subnets = ["shared-dns"], ips = [] },
]

# Outbound forwarding rules. endpoint references an outbound resolver_endpoints[].name.
resolver_rules = [
  # { name = "fwd-onprem", endpoint = "lz-dns-outbound", domain_name = "corp.onprem.", target_ips = ["192.168.0.10", "192.168.0.11"], vpcs = ["vpc-shared"] },
]

# DNS query access logging to LTS. lts_group/lts_stream are LTS NAMES.
access_logs = [
  # { name = "dns-query-log", lts_group = "lz-dns-logs", lts_stream = "dns-queries", vpcs = ["vpc-shared"] },
]
