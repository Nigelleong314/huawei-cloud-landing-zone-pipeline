{
  "home_region": "ap-southeast-1",
  "default_tags": {
    "org": "example"
  },
  "foundation_state_bucket": "example-lz-obs-tfstate-01",
  "scps": {
    "deny_leave_org": {
      "name": "example-deny-leave-org",
      "enforce": true
    },
    "deny_outside_allowed_region": {
      "name": "example-region-lock",
      "enforce": true,
      "allowed_regions": [
        "ap-southeast-1"
      ]
    },
    "require_mandatory_tags": {
      "name": "example-require-tags",
      "mandatory_tags": [
        "env",
        "owner"
      ]
    }
  },
  "predefined_tags": [
    {
      "key": "env",
      "values": [
        "prd",
        "dev",
        "sbx"
      ]
    },
    {
      "key": "owner",
      "values": []
    }
  ],
  "config_admin_account": "EXAMPLE-Security",
  "config": {
    "enable_recorder": true,
    "recorder_agency_name": "rms_tracker_agency",
    "create_recorder_agency": true,
    "recorder_bucket_name": "example-lz-obs-configrec-01",
    "create_recorder_bucket": true,
    "recorder_bucket_region": "ap-southeast-1",
    "recorder_all_supported": true,
    "enable_aggregator": true,
    "aggregator_name": "example-org-aggregator"
  },
  "conformance_packs": [
    {
      "name": "Security Level 1",
      "enabled": true,
      "template_key": "Operational-Best-Practices-for-Security-Level1.tf.json",
      "pack_name": "example-sec-l1"
    }
  ]
}