    {
      "protocol": "email",
      "endpoint": "noc@example.com"
    }
  ],
  "one_click_alarms": [
    {
      "namespace": "SYS.ECS",
      "event_enabled": true
    },
    {
      "namespace": "SYS.VPC",
      "event_enabled": true
    }
  ]
