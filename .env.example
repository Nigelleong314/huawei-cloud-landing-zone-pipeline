# Copy to .env (never committed) or export in your shell / CI environment.
# All values are optional except the cloud credentials at deploy time.

# --- cloud credentials (deploy-time only; never in the spec or the repo) ---
# Read from the environment only; never written to any file in the tree.
HW_ACCESS_KEY=
HW_SECRET_KEY=
# Temporary keys only (pair with the key it was minted from):
#HW_SECURITY_TOKEN=

# The OBS state backend is S3-compatible and reads AWS-style variables
# (the same values as HW_*; AWS_SESSION_TOKEN for a temporary key):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# REQUIRED with Terraform 1.11+ or state saves fail AFTER a successful apply:
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- pipeline knobs (defaults are fine for the standard layout) ---
# Where emitted HCL finds the module library, relative to each env dir:
#LZ_MODULE_SOURCE_ROOT=../../modules
# Transient error substrings the runner retries exactly once:
#LZ_TRANSIENT_SIGNATURES=LTS.2101,EPS.0004
# Regression-harness targets (defaults: the repo's example spec + tree):
#LZ_VERIFY_IR=
#LZ_VERIFY_ENVS=
# Rate card selection for cost estimates (pricing/<region>.json):
#LZ_PRICING_REGION=
# App workspace (defaults to a walk-up from the current directory):
#LZ_WORKSPACE=
