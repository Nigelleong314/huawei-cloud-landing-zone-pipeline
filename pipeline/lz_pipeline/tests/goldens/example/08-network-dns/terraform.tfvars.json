{
  "home_region": "ap-southeast-1",
  "default_tags": {
    "org": "example"
  },
  "foundation_state_bucket": "example-lz-obs-tfstate-01",
  "network_state_bucket": "example-lz-obs-tfstate-01",
  "dns_account": "EXAMPLE-SharedInfra",
  "enterprise_project_name": "example-shared",
  "private_zones": [
    {
      "name": "corp.example.internal",
      "vpcs": [
        "example-hub-core-vpc"
      ],
      "ttl": 300,
      "recursive": true,
      "description": "Internal apps zone"
    }
  ],
  "recordsets": [
    {
      "zone": "corp.example.internal",
      "name": "app.corp.example.internal",
      "type": "A",
      "records": [
        "10.42.8.10"
      ],
      "ttl": 300,
      "description": "App VIP"
    }
  ],
  "resolver_endpoints": [
    {
      "name": "example-resolver-in",
      "direction": "inbound",
      "vpc": "example-hub-core-vpc",
      "subnets": [
        "example-core-sub-a"
      ],
      "ips": []
    },
    {
      "name": "example-resolver-out",
      "direction": "outbound",
      "vpc": "example-hub-core-vpc",
      "subnets": [
        "example-core-sub-a"
      ],
      "ips": []
    }
  ],
  "resolver_rules": [
    {
      "name": "ad-forward",
      "endpoint": "example-resolver-out",
      "domain_name": "ad.example.com",
      "target_ips": [
        "10.10.1.53",
        "10.10.2.53"
      ],
      "vpcs": [
        "example-hub-core-vpc"
      ]
    }
  ],
  "access_logs": [
    {
      "name": "example-dns-qlog",
      "lts_group": "example-dns-qlog",
      "lts_stream": "example-dns-qlog",
      "vpcs": [
        "example-hub-core-vpc"
      ]
    }
  ]
}