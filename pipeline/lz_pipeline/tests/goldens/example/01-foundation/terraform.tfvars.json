{
  "home_region": "ap-southeast-1",
  "default_tags": {
    "org": "example"
  },
  "identity_center_alias": "example-cloud",
  "cross_account_agency_name": "OrganizationAccountAccessAgency",
  "create_enterprise_project": true,
  "enterprise_project_name": "example-shared",
  "enabled_policy_types": [
    "service_control_policy",
    "tag_policy"
  ],
  "organizational_units": {
    "Security": {
      "parent": ""
    },
    "Infrastructure": {
      "parent": ""
    },
    "Workloads": {
      "parent": ""
    },
    "Sandbox": {
      "parent": "Workloads"
    }
  },
  "trusted_services": [
    "service.CTS",
    "service.LTS",
    "service.RAM",
    "service.Config"
  ],
  "delegated_administrators": {
    "service.CTS": "EXAMPLE-Security",
    "service.LTS": "EXAMPLE-LogArchive",
    "service.Config": "EXAMPLE-Security"
  },
  "core_accounts": {
    "EXAMPLE-LogArchive": {
      "email": "cloud-logs@example.com",
      "ou": "Security",
      "description": "Central log archive account"
    },
    "EXAMPLE-Security": {
      "email": "cloud-sec@example.com",
      "ou": "Security",
      "description": "Security tooling and audit administration"
    }
  },
  "workload_accounts": {
    "EXAMPLE-SharedInfra": {
      "email": "cloud-infra@example.com",
      "ou": "Infrastructure",
      "description": "Hub network account"
    },
    "EXAMPLE-Prod-A": {
      "email": "cloud-prod-a@example.com",
      "ou": "Workloads",
      "description": "Production workload A"
    },
    "EXAMPLE-Sandbox1": {
      "email": "cloud-sbx@example.com",
      "ou": "Sandbox",
      "description": "Sandbox account (network detached)"
    }
  },
  "tag_policies": [
    {
      "name": "tp-env",
      "description": "Enforce env in [prd, dev, sbx] on [org]",
      "content": "{\"tags\":{\"env\":{\"tag_key\":{\"@@assign\":\"env\"},\"tag_value\":{\"@@assign\":[\"prd\",\"dev\",\"sbx\"]},\"enforced_for\":{\"@@assign\":[\"org\"]}}}}"
    }
  ]
}